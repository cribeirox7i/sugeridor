# Copie para .env.local e preencha com os valores reais do seu projeto Supabase
# (Dashboard do Supabase > Project Settings > API).

# Público — exposto ao navegador, usado pelo client e pelo login do admin.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secreto — nunca prefixar com NEXT_PUBLIC_, nunca expor ao navegador.
# Usado por server actions/rotas de API que precisam ignorar RLS (ex: gravar
# ofertas vindas do normalizador de IA, disparar o workflow de scraping).
SUPABASE_SERVICE_ROLE_KEY=

# Usado pela rota que dispara o GitHub Actions (workflow_dispatch) a partir do
# botão "Rodar coleta" no admin. Fine-grained PAT com escopo "actions: write"
# só neste repositório.
GITHUB_PAT=
GITHUB_OWNER=
GITHUB_REPO=

# Usado pelo normalizador de IA (e-mail, scraping variável, OCR de print do WhatsApp).
ANTHROPIC_API_KEY=
